# ============================================================
# Smart Energy Meter Dashboard — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your Supabase credentials.
# NEVER commit .env.local to Git.
# ============================================================

# Public — safe for browser (NEXT_PUBLIC_ prefix exposes to client bundle)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Secret — server-side ONLY (NO NEXT_PUBLIC_ prefix!)
# Used ONLY in Next.js API routes (src/app/api/*)
# Next.js will NOT expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
