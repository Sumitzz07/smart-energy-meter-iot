# ============================================================
# Smart Energy Meter Dashboard — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your credentials.
# NEVER commit .env.local to Git.
# ============================================================

# --- Supabase (Public Client) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- Supabase (Server-side ONLY) ---
# Used in server-side API routes to update alert delivery status & bypass RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Gmail SMTP (Nodemailer) Email Configuration ---
# Host: smtp.gmail.com | Port: 465 (SSL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Your full Gmail address
SMTP_USER=your-email@gmail.com
# 16-character Google App Password (generated under Google Account -> Security -> 2-Step Verification)
SMTP_PASS=your-16-char-app-password
# From Header (e.g. "Smart Energy Meter" <your-email@gmail.com>)
ALERT_FROM_EMAIL="Smart Energy Meter" <your-email@gmail.com>
# Destination alert email recipient
ALERT_TO_EMAIL=your-recipient-email@gmail.com

# --- Security & Anti-Spam Cooldown ---
# Secret token to secure /api/alerts/notify webhook against unauthorized POSTs
ALERT_WEBHOOK_SECRET=your-random-webhook-secret
# Minimum cooldown period in seconds to prevent duplicate alert emails (default: 300 = 5 mins)
ALERT_COOLDOWN_SECONDS=300
